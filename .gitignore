# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/design-v4-screenshots/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ...but the example carries no secrets and is the only record of what
# NEXT_PUBLIC_SITE_URL is for. Without this it is ignored by the rule above
# and never reaches anyone else.
!.env.example

# local audit reports and scratch screenshots (kept on disk, never committed)
industries-audit/
mega-menu-screens/

# live-site reference images (flashweather.ai originals), never committed
live-images/

# QA audit reports (local only)
qa/

# mascot design renders (Three.js + Playwright scripts, local only)
design/mascot-renders/
